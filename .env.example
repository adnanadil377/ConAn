# ─────────────────────────────────────────────────────────────────────────────
# GitHub Contribution Analytics Lakehouse — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Docker Compose automatically loads .env from the project root when running:
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (PAT)
# Increases GitHub API rate limit from 60 req/hr (anonymous) to 5,000 req/hr.
# Generate one at: https://github.com/settings/tokens (classic, "public_repo" scope)
# or fine-grained token with Read access to public repositories.
GITHUB_TOKEN=ghp_your_token_here

# Note: Tracked repositories are selected dynamically in the dashboard
# (Live Feed tab or repository manager). No need to configure them here.

# ─────────────────────────────────────────────────────────────────────────────
# Optional Overrides (default Docker Compose service values shown below)
# ─────────────────────────────────────────────────────────────────────────────

# Kafka Broker (host:port)
# KAFKA_BOOTSTRAP=kafka:29092

# Target Kafka Topic for GitHub events
# KAFKA_TOPIC=github.events.raw

# Application Postgres Database (Metastore & Serving layer)
# POSTGRES_USER=analytics
# POSTGRES_PASSWORD=analytics
# POSTGRES_DB=github_analytics
# POSTGRES_PORT=5432

# HDFS WebHDFS URL (NameNode)
# HDFS_NAMENODE_URL=http://namenode:9870
